<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta2/dist/css/adminlte.min.css">
    <style>
        #main-chart { width: 100%; height: 400px; }
        .table-scroll { max-height: 420px; overflow-y: auto; border-radius: 6px; }
        #data-table thead th { position: sticky; top: 0; background: #343a40; color: #fff; z-index: 2; font-weight: 500; }
        .chart-type-btn { border-radius: 20px !important; padding: 4px 14px; font-size: 13px; }
        .chart-type-btn.active { background: #0d6efd; color: #fff; border-color: #0d6efd; }
        .stat-pill { background: #f0f4ff; border-radius: 20px; padding: 3px 12px; font-size: 12.5px; color: #444; }
        #sql-panel { transition: all 0.3s ease; }
        .report-header-title { font-size: 1.4rem; font-weight: 700; }
        #edit-name-input { max-width: 320px; }
    </style>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
    <%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

    <main class="app-main">
        <!-- ── Header ── -->
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row align-items-center gy-2">
                    <!-- Title + breadcrumb -->
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a href="/reports" class="btn btn-sm btn-outline-secondary" title="กลับ"><i class="bi bi-arrow-left"></i></a>
                            <span class="report-header-title" id="report-title-display"><%= report.name %></span>
                            <% if (report.created_by === user.id || user.role === 'admin') { %>
                            <input type="text" id="edit-name-input" class="form-control form-control-sm d-none" value="<%= report.name %>">
                            <button class="btn btn-sm btn-link p-0 text-muted" id="btn-toggle-edit-name" title="แก้ไขชื่อ"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-success d-none px-2" id="btn-save-name"><i class="bi bi-check-lg"></i></button>
                            <% } %>
                        </div>
                        <div class="d-flex gap-2 mt-1 ms-5 flex-wrap">
                            <span class="stat-pill"><i class="bi bi-person me-1"></i><%= report.creator_email || 'Unknown' %></span>
                            <span class="stat-pill"><i class="bi bi-calendar3 me-1"></i><%= new Date(report.created_at).toLocaleString('th-TH') %></span>
                            <% if (report.is_public) { %><span class="stat-pill text-success"><i class="bi bi-globe me-1"></i>Public</span><% } %>
                        </div>
                    </div>
                    <!-- Action buttons -->
                    <div class="col-md-5 text-md-end d-flex gap-2 justify-content-md-end flex-wrap">
                        <a href="/reports/<%= report.id %>/export" class="btn btn-sm btn-success" target="_blank" id="btn-export-csv">
                            <i class="bi bi-file-earmark-excel"></i> Export CSV
                        </a>
                        <% if (report.created_by === user.id || user.role === 'admin') { %>
                        <button class="btn btn-sm btn-primary" id="btn-open-sql">
                            <i class="bi bi-pencil-square"></i> แก้ไข SQL
                        </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-content">
            <div class="container-fluid">

                <!-- ── Dynamic Filter Bar (Appears if query contains {{params}}) ── -->
                <div id="filter-bar-card" class="card shadow-sm mb-3 border-primary border-start border-4 d-none">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex align-items-center gap-2 flex-wrap" id="filter-bar-form">
                            <span class="fw-bold text-primary me-2" style="font-size:13px;"><i class="bi bi-funnel-fill me-1"></i>ตัวกรองรายงาน:</span>
                            <div class="d-flex align-items-center gap-2 flex-wrap" id="filter-controls-container"></div>
                            <button class="btn btn-sm btn-primary ms-auto" id="btn-apply-filters">
                                <i class="bi bi-search me-1"></i>ค้นหาข้อมูล
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ── Chart type bar ── -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
                        <span class="text-muted" style="font-size:13px;font-weight:600;">มุมมอง:</span>
                        <div class="d-flex gap-2" id="chart-type-switcher">
                            <button class="btn btn-sm btn-outline-primary chart-type-btn" data-type="bar"><i class="bi bi-bar-chart-fill"></i> Bar</button>
                            <button class="btn btn-sm btn-outline-primary chart-type-btn" data-type="hbar"><i class="bi bi-bar-chart-steps"></i> H-Bar</button>
                            <button class="btn btn-sm btn-outline-primary chart-type-btn" data-type="line"><i class="bi bi-graph-up"></i> Line</button>
                            <button class="btn btn-sm btn-outline-primary chart-type-btn" data-type="pie"><i class="bi bi-pie-chart-fill"></i> Pie</button>
                            <button class="btn btn-sm btn-outline-primary chart-type-btn" data-type="table"><i class="bi bi-table"></i> Table</button>
                        </div>
                        <div class="ms-auto d-flex gap-3 flex-wrap" id="stats-bar" style="font-size:13px;color:#666;">
                            <span><i class="bi bi-grid-3x3-gap text-primary"></i> คอลัมน์: <strong id="stat-cols">-</strong></span>
                            <span><i class="bi bi-list-ul text-primary"></i> แถว: <strong id="stat-rows">-</strong></span>
                        </div>
                    </div>
                </div>

                <!-- ── Data area ── -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body p-3">
                        <!-- Loading -->
                        <div id="loading-state" class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                            <p class="mt-2 text-muted">กำลังโหลดข้อมูล...</p>
                        </div>
                        <!-- Error -->
                        <div id="error-state" class="alert alert-danger d-none"></div>
                        <!-- Chart -->
                        <div id="chart-area" class="d-none">
                            <div id="main-chart"></div>
                        </div>
                        <!-- Table -->
                        <div id="table-area" class="table-scroll d-none">
                            <table class="table table-bordered table-hover table-sm mb-0" id="data-table">
                                <thead><tr id="table-head"></tr></thead>
                                <tbody id="table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ── SQL Editor (hidden by default) ── -->
                <% if (report.created_by === user.id || user.role === 'admin') { %>
                <div id="sql-panel" class="d-none">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-code-slash me-2"></i>แก้ไข SQL Query</h5>
                            <div class="d-flex gap-2 align-items-center">
                                <select id="edit-chart-type" class="form-select form-select-sm w-auto">
                                    <option value="table" <%= report.chart_type==='table'?'selected':'' %>>Table View</option>
                                    <option value="bar"   <%= report.chart_type==='bar'  ?'selected':'' %>>Bar Chart (แนวตั้ง)</option>
                                    <option value="hbar"  <%= report.chart_type==='hbar' ?'selected':'' %>>Horizontal Bar (แนวนอน)</option>
                                    <option value="pie"   <%= report.chart_type==='pie'  ?'selected':'' %>>Pie Chart</option>
                                    <option value="line"  <%= report.chart_type==='line' ?'selected':'' %>>Line Chart</option>
                                </select>
                                <button class="btn btn-sm btn-outline-primary" id="btn-run-sql"><i class="bi bi-play-fill"></i> ทดสอบ</button>
                                <button class="btn btn-sm btn-success" id="btn-save-sql"><i class="bi bi-save"></i> บันทึก</button>
                                <button class="btn btn-sm btn-outline-secondary" id="btn-close-sql"><i class="bi bi-x-lg"></i></button>
                            </div>
                        </div>
                        <!-- ── Quick Variable Toolbar ── -->
                        <div class="card-body p-2 border-bottom bg-light">
                            <div class="d-flex align-items-center gap-1 flex-wrap" id="var-toolbar">
                                <span class="small fw-bold text-secondary me-1" style="font-size: 11px;">แทรกตัวแปร:</span>
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 btn-insert-var" data-code="v.vstdate BETWEEN {{start_date}} AND {{end_date}}" style="font-size: 11px;" title="แทรกช่วงวันที่">
                                    <i class="bi bi-calendar-range me-1"></i>ช่วงวันที่
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 btn-insert-var" data-code="v.vstdate = {{date}}" style="font-size: 11px;" title="แทรกวันที่">
                                    <i class="bi bi-calendar-event me-1"></i>วันที่
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 btn-insert-var" data-code="d.code = {{doctor_code}}" style="font-size: 11px;" title="แทรกรหัสแพทย์">
                                    <i class="bi bi-person-badge me-1"></i>แพทย์
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 btn-insert-var" data-code="name LIKE {{search_text}}" style="font-size: 11px;" title="แทรกช่องค้นหา">
                                    <i class="bi bi-search me-1"></i>ค้นหา
                                </button>
                                <button type="button" class="btn btn-xs btn-primary py-0 px-2 ms-auto" id="btn-open-var-wizard" style="font-size: 11px;">
                                    <i class="bi bi-magic me-1"></i>สร้างตัวแปร...
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <div id="sql-editor" style="height:230px;border:1px solid #dee2e6;border-radius:4px;"></div>
                        </div>
                        <!-- ── Visual Config Panel (แกน X, แกน Y หลายค่า) ── -->
                        <div class="card-body p-2 border-top bg-light" id="visual-config-panel">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-5">
                                     <div class="d-flex align-items-center gap-1">
                                         <label class="form-label mb-0 small text-secondary fw-bold text-nowrap" style="font-size:12px;"><i class="bi bi-arrow-right text-primary me-1"></i>แกน X (เลือกได้หลายค่า):</label>
                                         <div class="dropdown flex-grow-1" id="x-multi-select-dropdown">
                                             <button class="btn btn-sm btn-white border dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center bg-white py-1 px-2" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="btn-x-multi" style="min-height:31px;">
                                                 <span id="x-multi-label" class="text-truncate" style="font-size:12px;">— ไม่เลือก (ใช้อัตโนมัติ) —</span>
                                             </button>
                                             <div class="dropdown-menu p-2 shadow" id="x-multi-options" style="max-height:240px; overflow-y:auto; font-size:12px; min-width:240px;">
                                                 <!-- Checkboxes populated dynamically -->
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                                 <div class="col-md-4">
                                    <div class="d-flex align-items-center gap-1">
                                        <label class="form-label mb-0 small text-secondary fw-bold text-nowrap" style="font-size:12px;"><i class="bi bi-arrow-up text-success me-1"></i>แกน Y (เลือกได้หลายค่า):</label>
                                        <div class="dropdown flex-grow-1" id="y-multi-select-dropdown">
                                            <button class="btn btn-sm btn-white border dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center bg-white py-1 px-2" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="btn-y-multi" style="min-height:31px;">
                                                <span id="y-multi-label" class="text-truncate" style="font-size:12px;">— เลือกค่าแกน Y —</span>
                                            </button>
                                            <div class="dropdown-menu p-2 shadow" id="y-multi-options" style="max-height:240px; overflow-y:auto; font-size:12px; min-width:220px;">
                                                <!-- Checkboxes populated dynamically -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 text-end">
                                    <button type="button" class="btn btn-sm btn-primary w-100" id="btn-apply-config">
                                        <i class="bi bi-sliders me-1"></i>ปรับมุมมองกราฟ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

            </div>
        </div>
    </main>

    <%- include('../../partials/footer') %>
</div>

<!-- Pass data safely via JSON -->
<script>
    window.REPORT_META = <%- JSON.stringify({
        id:            report.id,
        name:          report.name,
        sql_query:     report.sql_query,
        chart_type:    report.chart_type,
        visual_config: report.visual_config || null,
        can_edit:      (report.created_by === user.id || user.role === 'admin')
    }) %>;
</script>

<!-- Quick Variable Wizard Modal -->
<div class="modal fade" id="varWizardModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0"><i class="bi bi-magic me-2"></i>เครื่องมือช่วยสร้างตัวแปร (Variable Wizard)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">1. เลือกประเภทตัวแปร:</label>
                    <select class="form-select form-select-sm" id="wiz-type">
                        <option value="start_date">ช่วงวันที่เริ่มต้น ({{start_date}})</option>
                        <option value="end_date">ช่วงวันที่สิ้นสุด ({{end_date}})</option>
                        <option value="date">วันที่เดี่ยว ({{date}})</option>
                        <option value="select">ตัวเลือกเดี่ยว ({{select_var:select}})</option>
                        <option value="in">ตัวเลือกหลายรายการ (IN ({{multi_var:in}}))</option>
                        <option value="text">ช่องค้นหาข้อความ ({{text_var}})</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">2. ตั้งชื่อตัวแปร:</label>
                    <input type="text" class="form-control form-control-sm" id="wiz-name" value="position_id" placeholder="เช่น position_id, doctor_code">
                </div>
                <div class="alert alert-info py-2 small mb-0">
                    <i class="bi bi-info-circle me-1"></i>ตัวแปรนี้จะสร้างเป็นช่องอินพุตบนรายงาน ให้ผู้ใช้งานเลือกก่อนดูข้อมูลได้ทันที
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-sm btn-primary" id="btn-wiz-insert"><i class="bi bi-plus-circle me-1"></i>แทรกใน SQL</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta2/dist/js/adminlte.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<% if (report.created_by === user.id || user.role === 'admin') { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
<% } %>
<script src="/js/report-view.js"></script>
</body>
</html>
